# Copy this file to .env.local and fill in what you use. .env.local is git-ignored and only read by the
# dev/preview server, never sent to the browser. Restart `npm run dev` after changing it.

# n8n workflow that powers Melo (see docs/n8n-rag-guide.md). Every click on the Melo button sends
# {"action":"open"} and every chat message sends {"action":"message"} to this webhook.
N8N_WEBHOOK_URL=

# Optional shared secret, sent as the X-Melo-Token header (pair it with Header Auth on the n8n Webhook node).
N8N_WEBHOOK_TOKEN=

# Optional: Claude answers when n8n isn't configured or doesn't answer.
# With neither n8n nor a key, Melo runs in offline demo mode.
ANTHROPIC_API_KEY=
