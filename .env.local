# Local settings for the dev/preview server. Git-ignored; never sent to the browser.

# n8n workflow that powers Melo. Production URL: works whenever the workflow is published in n8n.
# For testing in the n8n editor instead, use /webhook-test/ and click "Execute workflow" before each call.
N8N_WEBHOOK_URL=https://creedxdxd.app.n8n.cloud/webhook/feb6c428-ecd5-46fe-829c-5b21abb67915

# Optional shared secret, sent as the X-Melo-Token header (pair it with Header Auth on the n8n Webhook node).
N8N_WEBHOOK_TOKEN=

# Optional: Claude answers when n8n doesn't. Leave empty to fall back to offline demo answers instead.
ANTHROPIC_API_KEY=
